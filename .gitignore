# Secrets / config
.env

# Database files
data/*.db
data/*.db-journal
data/*.sqlite3

# Local fallback store (runtime user data; not source)
data/local_store.json
data/*.tmp

# Character metadata snapshot (runtime cache of upstream Enka data, refreshed on a TTL)
data/character_meta.json

# enka library runtime asset cache (downloaded at runtime)
.enka_py/

# Runtime-downloaded rendering assets (fonts + character artwork cache)
assets/fonts/
assets/characters/*.png

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# OS / editor
.DS_Store
.idea/
.vscode/

# Local caches
.cache/
tests/output/
