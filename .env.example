# --- Telegram ---
# Get this from @BotFather. Required to run the bot. Copy this file to .env and set it.
# Never commit a real token — .env is gitignored; keep secrets there only.
BOT_TOKEN=

# Bot administrators — comma/space-separated Telegram user ids allowed to run owner-only
# commands (e.g. /broadcast). Get your id from @userinfobot. Leave empty to disable them.
#   ADMIN_IDS=123456789,987654321
ADMIN_IDS=

# HoYoLAB session cookie for the account /redeem claims codes on. Paste the FULL cookie
# string from an authenticated HoYoLAB session (browser DevTools → Application → Cookies,
# or a cookie exporter). Must include cookie_token_v2 + account_id_v2 (or legacy
# cookie_token + account_id) for redemption to work. Leave empty to disable /redeem.
#   HOYOLAB_COOKIE=cookie_token_v2=...; account_id_v2=...; ltoken_v2=...; ltuid_v2=...
HOYOLAB_COOKIE=

# OPTIONAL. Dedicated encryption key for stored HoYoLAB sessions (/hoyologin). If left empty,
# the key is derived from BOT_TOKEN, so per-user login already works with no extra setup. Set
# this (any long random string, e.g. `openssl rand -hex 32`) only if you want session
# encryption independent of the bot token. Keep it secret and stable — changing it makes
# previously stored logins unreadable (users just re-run /hoyologin).
#   HOYOLAB_SECRET=change-me-to-a-long-random-string
HOYOLAB_SECRET=

# --- Redis (primary datastore) ---
# Required. Upstash connection URL. A redis:// Upstash URL is auto-upgraded to TLS.
#   REDIS_URL=redis://default:<password>@<host>.upstash.io:6379
REDIS_URL=

# --- Localization ---
DEFAULT_LANGUAGE=en

# --- Caching (seconds) ---
# How long to cache Enka showcase responses and Akasha ranking responses.
ENKA_CACHE_TTL=300
AKASHA_CACHE_TTL=600

# --- Assets ---
# Root directory for artwork/icons/frames. Loaded dynamically at runtime.
ASSETS_DIR=assets

# --- Logging ---
LOG_LEVEL=INFO
